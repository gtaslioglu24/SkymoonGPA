# Public build-time config. No secrets belong in this file — anything prefixed
# with VITE_ is inlined into the JavaScript bundle and visible to every visitor.

# Canonical origin, no trailing slash. Drives canonical, Open Graph, hreflang,
# JSON-LD and the sitemap — change it here and everything follows.
#
# Only ever point this at a domain you control: a canonical tag aimed at
# someone else's site hands them your search ranking. When the custom domain
# is ready, swap this line and add a 301 from the Vercel subdomain to it.
VITE_SITE_URL=https://skymoongpa.vercel.app

# Plausible analytics (cookieless). Empty = no analytics, no third-party script.
# Set to your domain after adding the site at plausible.io, and add
# https://plausible.io to script-src/connect-src in netlify.toml + vercel.json.
VITE_PLAUSIBLE_DOMAIN=

# Where the footer's feedback link points. Empty = the link is hidden.
# Example: VITE_FEEDBACK_URL=https://github.com/<user>/skymoon-gpa/issues
VITE_FEEDBACK_URL=
